{
  "manifest_version": 3,
  "name": "AI Gauge",
  "version": "0.0.0",
  "description": "__MSG_extension_description__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "optional_host_permissions": ["https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "AI Gauge", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
