{
  "name": "ai-gauge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "package": "node scripts/package.mjs",
    "test": "tsx --import ./tests/helpers/svg-loader.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "check": "npm run lint && npm test && npm run build && npm run audit:extension",
    "test:browser:fixture": "npm run build && node scripts/browser-fixture.mjs",
    "test:browser:extension": "npm run build && node scripts/browser-smoke.mjs",
    "audit:extension": "node scripts/audit-build.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
